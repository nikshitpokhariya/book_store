# ========================================================
# BookBazzar Backend Environment Configuration
# ========================================================

# MongoDB Database URI (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=myapp

# JWT Authentication (at least 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_ISSUER=myapp-api
ACCESS_TOKEN_LIFETIME=900
REFRESH_TOKEN_LIFETIME=2592000
SECURE_COOKIES=false

# Cloudinary CDN Configuration (Optional: for cloud media storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
